+function get_codec_list()
+{
+    global $link;
+    global $config;
+
+    $index = 0;
+    $values = array();
+    $resultset = array('PCMA', 'PCMU','G723','G722','G729','G729a','speex','GSM','opus','EVS');
+
+    for ($i = 0; $i < count($resultset); $i++) {
+        $values[$index][0] = $resultset[$i];
+        $index++;
+    }
+
+    return $values;
+}
 
+function print_codec_list()
+{
+    $array_values = get_codec_list();
+    $start_index = 0;
+    $end_index = sizeof($array_values);
+?>
+<select name="extra_codecs_value" id="extra_codecs_value" size="1"
+        class="dataSelect"
+        style="width:342px!important; margin-left:1px; margin-top:2px;">
+<?php
+    for ($i = $start_index; $i < $end_index; $i++) {
+        echo '<option value="transcode-'.$array_values[$i][0].'">(#'.$array_values[$i][0].')</option>';
+    }
+?>
+</select>
+<?php
+}

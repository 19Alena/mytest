+// Build an index of current agent and queue statuses
+$current_statuses = [];
+
+foreach ($agents as $agent) {
+
+    $agent_uuid = $agent['call_center_agent_uuid'];
+
+    // Global agent status
+    $current_statuses['agent'][$agent_uuid] = $agent['agent_status'] ?? null;
+
+    // Per-queue agent status
+    if (!empty($agent['queues'])) {
+        foreach ($agent['queues'] as $queue) {
+
+            $queue_uuid = $queue['call_center_queue_uuid'];
+
+            $current_statuses['queue'][$agent_uuid][$queue_uuid] =
+                $queue['queue_status'];
+        }
+    }
+}
+// Remove unchanged rows from POST
+
+if (!empty($_POST['agents'])) {
+
+    foreach ($_POST['agents'] as $key => $row) {
+
+        $agent_uuid = $row['agent_uuid'] ?? null;
+        $new_status = $row['agent_status'] ?? null;
+
+        if (isset($row['queue_uuid'])) {
+
+            // Per-queue login
+            $queue_uuid = $row['queue_uuid'];
+
+            $original_status =
+                $current_statuses['queue'][$agent_uuid][$queue_uuid] ?? null;
+
+        } else {
+
+            // Global agent status
+            $original_status =
+                $current_statuses['agent'][$agent_uuid] ?? null;
+        }
+
+        if ($original_status !== null && $original_status === $new_status) {
+            unset($_POST['agents'][$key]);
+        }
+    }
+}
 

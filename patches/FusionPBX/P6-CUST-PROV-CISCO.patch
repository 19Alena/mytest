 //get the device address for Cisco 79xx in the URL as &name=SEP000000000000
 	if (empty($device_address)) {
@@ -410,7 +410,46 @@
 			return;
 		}
 	}
-
+function encrypt_cisco_profile($file_contents, $key) {
+    $temp_in = tempnam(sys_get_temp_dir(), 'cisco_in_');
+    $temp_out = tempnam(sys_get_temp_dir(), 'cisco_out_');
+
+    try {
+        // Write the generated XML to a temporary file
+        if (file_put_contents($temp_in, $file_contents) === false) {
+            throw new RuntimeException('Unable to create temporary input file');
+        }
+
+        // Cisco SPA expects:
+        // openssl enc -e -aes-256-cbc -md md5 -k <key>
+        $command = sprintf(
+            'openssl enc -e -aes-256-cbc -md md5 -k %s -in %s -out %s 2>&1',
+            escapeshellarg($key),
+            escapeshellarg($temp_in),
+            escapeshellarg($temp_out)
+        );
+
+        exec($command, $output, $return_code);
+
+        if ($return_code !== 0) {
+            throw new RuntimeException(
+                'Cisco profile encryption failed: ' . implode("\n", $output)
+            );
+        }
+
+        $encrypted = file_get_contents($temp_out);
+
+        if ($encrypted === false) {
+            throw new RuntimeException('Unable to read encrypted Cisco profile');
+        }
+
+        return $encrypted;
+    }
+    finally {
+        @unlink($temp_in);
+        @unlink($temp_out);
+    }
+}
 //start the buffer
 	ob_start();
 

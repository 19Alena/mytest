+
+function fmt_binary($x, $numbits, $retbit) {
+        // Convert to binary
+        $bin = decbin($x);
+        $bin = substr(str_repeat(0,$numbits),0,$numbits - strlen($bin)) . $bin;
+        // Split into x 4-bits long
+        $rtnval = '';
+        for ($x = 0; $x < $numbits/4; $x++) {
+            $rtnval .= ' ' . substr($bin,$x*4,4);
+        }
+    	// Get rid of first space.
+	    return ltrim($rtnval[$retbit]);
+} 
+function get_codec_list()
+{
+    global $link;
+    global $config;
+
+    $index = 0;
+    $values = array();
+    $resultset = array('PCMA', 'PCMU','G723','G722','G729','G729a','speex','GSM','opus','EVS');
+
+    for ($i = 0; $i < count($resultset); $i++) {
+        $values[$index][0] = $resultset[$i];
+        $index++;
+    }
+
+    return $values;
+}
+
+function print_codec_list()
+{
+    $array_values = get_codec_list();
+    $start_index = 0;
+    $end_index = sizeof($array_values);
+?>
+<select name="extra_codecs_value" id="extra_codecs_value" size="1"
+        class="dataSelect"
+        style="width:342px!important; margin-left:1px; margin-top:2px;">
+<?php
+    for ($i = $start_index; $i < $end_index; $i++) {
+        echo '<option value="transcode-'.$array_values[$i][0].'">(#'.$array_values[$i][0].')</option>';
+    }
+?>
+</select>
+<?php
+}
+function print_stripcodec_list()
+{
+    $array_values = get_codec_list();
+    $start_index = 0;
+    $end_index = sizeof($array_values);
+?>
+<select name="extra_codecs_stripvalue" id="extra_codecs_stripvalue" size="1"
+        class="dataSelect"
+        style="width:342px!important; margin-left:1px; margin-top:2px;">
+<?php
+    for ($i = $start_index; $i < $end_index; $i++) {
+        echo '<option value="codec-strip-'.$array_values[$i][0].'">(#'.$array_values[$i][0].')</option>';
+    }
+?>
+</select>
+<?php
+}
+
+function get_gwlist()
+{
+//include("db_connect.php");
+ global $link;
+ global $config;
+ $index = 0;
+ $values = array();
+ $sql="select * from ".get_settings_value("table_gateways")." order by gwid asc";
+ $stm = $link->prepare($sql);
+ if ($stm===FALSE) {
+	die('Failed to issue query ['.$sql.'], error message : ' . $link->errorInfo()[2]);
+ }
+ $stm->execute( array() );
+ $resultset = $stm->fetchAll(PDO::FETCH_ASSOC);
+ for($i=0;count($resultset)>$i;$i++)
+ {
+  $values[$index][0] = $resultset[$i]['gwid'];
+  $values[$index][1] = $resultset[$i]['address'];
+  $values[$index][2] = $resultset[$i]['description'];
+  $index++;
+ }
+ return($values);
+}
+
+function print_gwlist()
+{
+ $array_values = get_gwlist();
+ $start_index = 0;

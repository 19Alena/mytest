+			if (isset($combo["combo_default_hooks"]) && $combo["combo_default_hooks"]!=NULL)
+				$options[ $k ]['hook'] = $combo["combo_default_hooks"][$k] ;
+		}
+
+	}
+
+	return $options;
+}

+		$_SESSION['cdrviewer_search_end']="";
+        unset($_SESSION['cdrviewer_search_array']);
+	}
+
+	else {
+		if ($cdr_field=="none") {
+			$_SESSION['cdrviewer_search_val']="";
+			$_SESSION['cdrviewer_search_cdr_field']="";
+		} else {
+			$_SESSION['cdrviewer_search_val']=$search_regexp;
+			$_SESSION['cdrviewer_search_cdr_field'] = $cdr_field ;
+		}
+        $filtered_inputs = [];
+        foreach ($_POST['search_array'] ?? [] as $field => $value) {
+            $value = trim($value);
+            if ($value !== '') {
+                $filtered_inputs[$field] = $value;
+            }
+        }
+            $_SESSION['cdrviewer_search_array'] = $filtered_inputs;

+		if ($start_year=="none")
+			$_SESSION['cdrviewer_search_start']="";
+		else
+			$_SESSION['cdrviewer_search_start']=$start_year."-".$start_month."-".$start_day." ".$start_hour.":".$start_minute.":".$start_second;

+function sendJsonRpcRequest($url, $method, $id = "1", $params = []) {
+	$data = [
+		"jsonrpc" => "2.0",
+		"id" => $id,
+		"method" => $method
+	];
+
+	if (!empty($params)) {
+		$data["params"] = $params;
+	}
+
+	$ch = curl_init($url);
+
+	curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
+	curl_setopt($ch, CURLOPT_POST, true);
+	curl_setopt($ch, CURLOPT_HTTPHEADER, [
+		'Content-Type: application/json'
+	]);
+	curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($data));
+
+	$response = curl_exec($ch);
+
+	if (curl_errno($ch)) {
+		curl_close($ch);
+		return 'Curl error: ' . curl_error($ch);
+	}
+
+	curl_close($ch);
+	return $response;
+}
+function triggerRpcFromDatabase($method, $params = []) {
+	$host = 'localhost';
+	$port = '5432';
+	$dbname = 'opensips';
+	$user = 'opensips';
+	$password = '********';
+
+	$dsn = "pgsql:host=$host;port=$port;dbname=$dbname";
+	try {
+		$pdo = new PDO($dsn, $user, $password, [PDO:******** => PDO::ERRMODE_EXCEPTION]);
+	} catch (PDOException $e) {
+		die("Database connection failed: " . $e->getMessage());
+	}
 
+	$stmt = $pdo->query("SELECT mi_conn FROM ocp_boxes_config");
+	$results = $stmt->fetchAll(PDO::FETCH_ASSOC);
+
+	foreach ($results as $row) {
+		if (preg_match('/json:(10\.\d+\.\d+\.\d+:\d+\/mi)/', $row['mi_conn'], $matches)) {
+			$url = $matches[1];
+			$rpcResult = sendJsonRpcRequest($url, $method, "1", $params);
+		}
+	}
+}

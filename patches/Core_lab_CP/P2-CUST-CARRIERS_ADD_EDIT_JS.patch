+function handleExtraTranscoding() {
+    const transcoding = document.getElementById('extra_rtp');
+    const codecInput  = document.getElementById('extra_codecs');
+    const codecSelect = document.getElementById('extra_codecs_value');
+    const codecstripSelect = document.getElementById('extra_codecs_stripvalue');
+    const addBtn   = document.querySelector('input[name="add_codec"]');
+    const stripBtn   = document.querySelector('input[name="strip_codec"]');
+    const clearBtn = document.querySelector('input[name="clear_codec"]');
+    if (!transcoding || !codecInput || !codecSelect || !codecstripSelect) {
+        return;
+    }
+    if (transcoding.value === 'T') {
+        codecInput.disabled = false;
+        codecSelect.disabled = false;
+        codecstripSelect.disabled = false;
+        addBtn.disabled = false;
+        stripBtn.disabled = false;
+        clearBtn.disabled = false;
+        validate_extra_codec();
+    } else {
+        codecInput.value = '';
+        codecInput.disabled = true;
+        codecSelect.disabled = true;
+        codecstripSelect.disabled = true;    
+        addBtn.disabled = true;
+        stripBtn.disabled = true;
+        clearBtn.disabled = true;
+        validate_extra_codec();
+    }
+}
+
+function validate_extra_codec() {
+        var transcoding = document.getElementById('extra_rtp').value;
+        var field = 'extra_codecs';
+        var output = 'extra_codecs_ok';
+        var val = document.getElementById(field).value.trim();
+        var ret = 1;
+
+        if (transcoding !== 'T') {
+                document.getElementById(output).innerHTML = '';
+                document.getElementById(field).setAttribute("valid","ok");
+                form_full_check();
+                return ret;
+        }
+
+        if (val === '') {
+                document.getElementById(output).innerHTML =
+                        '<img src="../../../images/share/must-icon.png">';
+                document.getElementById(field).setAttribute("valid","ko");
+                ret = -1;
+        } else {
+                document.getElementById(output).innerHTML =
+                        '<img src="../../../images/share/ok_small.png">';
+                document.getElementById(field).setAttribute("valid","ok");
+        }
+
+        form_full_check();
+        return ret;
+}

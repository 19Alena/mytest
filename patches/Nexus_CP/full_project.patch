+				if ($value['type'] == "combo")
+					$combo_cache[ $key ] = get_custom_combo_options($value);
+			}
+			?>
+			<!-- PRELOAD combo  STARTS HERE -->
+
+			<!-- TABLE STARTS HERE -->
